# Normaliser les fichiers texte avec des fins de ligne LF
* text=auto eol=lf

# Scripts destinés à Windows
*.bat text eol=crlf
*.cmd text eol=crlf

# Fichiers binaires
*.avif binary
*.gif binary
*.ico binary
*.jpg binary
*.jpeg binary
*.png binary
*.pdf binary
*.webp binary
*.woff binary
*.woff2 binary
*.zip binary